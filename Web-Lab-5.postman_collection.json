              "});",
              "pm.test(\"Image source\", function () {",
              "    pm.expect(pm.response.headers.get(\"X-Cache-Source\")).to.eql(\"cache\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
