{
  "info": {
    "_postman_id": "f986000a-00b7-4a12-a3e4-864dc7db4bb1",
    "name": "Web Lab 5 — HTTP Cats Cache",
    "description": "Run in order. Begin with an empty server cache and expectedFirstSource=http.cat. For a second run with the retained cache, set expectedFirstSource=cache. In request 03, select a local JPEG in Body → binary and save the request. Use an image different from the default http.cat image for 200.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "59734501",
    "_collection_link": "https://go.postman.co/collection/59734501-f986000a-00b7-4a12-a3e4-864dc7db4bb1?source=collection_link"
  },
  "item": [
    {
      "name": "01 GET /418 — first request",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"JPEG content type\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"image/jpeg\");",
              "});",
              "pm.test(\"Image source\", function () {",
              "    pm.expect(pm.response.headers.get(\"X-Cache-Source\")).to.eql(pm.collectionVariables.get(\"expectedFirstSource\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/418",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "418"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 GET /418 — repeat from cache",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
