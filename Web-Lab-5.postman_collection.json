    {
      "name": "03 PUT /200 — upload a local JPEG",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () {\n    pm.response.to.have.status(201);\n});\npm.test(\"Image saved\", function () {\n    pm.expect(pm.response.text()).to.include(\"Image saved\");\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "image/jpeg"
          }
        ],
        "body": {
          "mode": "file",
          "file": {
            "src": "web-lab5-upload.jpg"
          }
        },
        "url": {
          "raw": "{{baseUrl}}/200",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "200"
          ]
        },
        "description": "Choose a local JPEG in Body → binary. The curl test file cache/curl-418.jpg is a suitable example because it is different from the default image for 200."
      },
      "response": []
    },
    {
